VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
UNITS
  DATABASE MICRONS 1000 ;
END UNITS

MACRO CHIP_ART_initials
  CLASS BLOCK ;
  ORIGIN 0.000 0.000 ;
  FOREIGN CHIP_ART_initials 0.000 0.000 ;
  SIZE 8.000 BY 8.000 ;
  SYMMETRY X Y R90 ;
  OBS
    LAYER met4 ;
      RECT 0.000 7.500 0.500 8.000 ;
      RECT 0.000 7.000 0.500 7.500 ;
      RECT 0.000 6.500 0.500 7.000 ;
      RECT 0.000 6.000 0.500 6.500 ;
      RECT 0.000 5.500 0.500 6.000 ;
      RECT 0.000 5.000 0.500 5.500 ;
      RECT 0.000 4.500 0.500 5.000 ;
      RECT 0.000 4.000 0.500 4.500 ;
      RECT 4.000 4.000 4.500 4.500 ;
      RECT 0.000 3.500 0.500 4.000 ;
      RECT 3.500 3.500 4.000 4.000 ;
      RECT 0.000 3.000 0.500 3.500 ;
      RECT 3.000 3.000 3.500 3.500 ;
      RECT 0.000 2.500 0.500 3.000 ;
      RECT 2.500 2.500 3.000 3.000 ;
      RECT 0.000 2.000 0.500 2.500 ;
      RECT 2.000 2.000 2.500 2.500 ;
      RECT 0.000 1.500 0.500 2.000 ;
      RECT 1.500 1.500 2.000 2.000 ;
      RECT 0.000 1.000 0.500 1.500 ;
      RECT 1.000 1.000 1.500 1.500 ;
      RECT 4.000 1.000 4.500 1.500 ;
      RECT 0.000 0.500 1.000 1.000 ;
      RECT 4.000 0.500 4.500 1.000 ;
      RECT 0.000 0.000 8.000 0.500 ;
      RECT 3.850 3.850 4.150 4.150 ;
      RECT 3.350 3.350 3.650 3.650 ;
      RECT 2.850 2.850 3.150 3.150 ;
      RECT 2.350 2.350 2.650 2.650 ;
      RECT 1.850 1.850 2.150 2.150 ;
      RECT 1.350 1.350 1.650 1.650 ;
      RECT 0.850 0.850 1.150 1.150 ;
  END
END CHIP_ART_initials

END LIBRARY

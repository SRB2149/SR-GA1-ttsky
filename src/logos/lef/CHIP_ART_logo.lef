  SIZE 5.600 BY 5.600 ;
  SYMMETRY X Y R90 ;
  OBS
    LAYER met4 ;
      RECT 0.000 5.250 0.350 5.600 ;
      RECT 0.000 4.900 0.350 5.250 ;
      RECT 0.000 4.550 0.350 4.900 ;
      RECT 0.000 4.200 0.350 4.550 ;
      RECT 0.000 3.850 0.350 4.200 ;
      RECT 0.000 3.500 0.350 3.850 ;
      RECT 0.000 3.150 0.350 3.500 ;
      RECT 0.000 2.800 0.350 3.150 ;
      RECT 2.800 2.800 3.150 3.150 ;
      RECT 0.000 2.450 0.350 2.800 ;
      RECT 2.450 2.450 2.800 2.800 ;
      RECT 0.000 2.100 0.350 2.450 ;
      RECT 2.100 2.100 2.450 2.450 ;
      RECT 0.000 1.750 0.350 2.100 ;
      RECT 1.750 1.750 2.100 2.100 ;
      RECT 0.000 1.400 0.350 1.750 ;
      RECT 1.400 1.400 1.750 1.750 ;
      RECT 0.000 1.050 0.350 1.400 ;
